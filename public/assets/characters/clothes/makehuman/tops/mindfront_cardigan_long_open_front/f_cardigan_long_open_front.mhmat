# MakeHuman Material definition

name f_cardigan_long_open_front

// Color shading attributes
diffuseColor  1 1 1
specularColor  0 0 0
shininess 0.1961
opacity 0

// Textures and properties
diffuseTexture F_Cardigan_Long_Open_Front.webp
normalmapTexture F_Cardigan_Long_Open_Front_NRM.webp
specularTexture F_Cardigan_Long_Open_Front_SPEC.webp

// Shader programme
shader shaders/glsl/litsphere
shaderParam litsphereTexture litspheres/lit_matte.png
backfaceCull False

// Configure built-in shader defines
shaderConfig diffuse true
shaderConfig bump false
shaderConfig normal  true
shaderConfig displacement  false
shaderConfig spec  true
shaderConfig vertexColors false
